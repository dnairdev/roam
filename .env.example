# PostgreSQL connection string (from Neon/Supabase/Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon: use the "direct" (non-pooled) connection here for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — set to your Vercel URL after deploying
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""

# Yelp (optional)
YELP_API_KEY=""
